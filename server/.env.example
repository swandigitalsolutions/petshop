PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pawnest
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed frontends (storefront + admin portal)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# Public URL of this API (used to build absolute image URLs)
PUBLIC_URL=http://localhost:5000

# Demo admin created by `npm run seed`
ADMIN_EMAIL=admin@pawnest.in
ADMIN_PASSWORD=Admin@123
